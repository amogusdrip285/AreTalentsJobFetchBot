# Copy this file to .env and fill it in. Never commit or share .env.

# Your AniDay headhunter account
ANIDAY_EMAIL=
ANIDAY_PASSWORD=

# Your AreTalents account, used only by `npm run setup` to create the API key.
# With `npm run setup -- --register`, this is the account that gets created.
ARETALENTS_EMAIL=
ARETALENTS_PASSWORD=

# The www is required.
ARETALENTS_BASE_URL=https://www.aretalents.com

# Filled in by `npm run setup`.
ARETALENTS_API_KEY=
ARETALENTS_API_KEY_EXPIRES_AT=

# Threads posting (node src/threadsCli.js). Any Threads account works: the bot logs in
# with these in Chrome, and saves the session to data/threads/ so later runs skip the login.
THREADS_USERNAME=
THREADS_PASSWORD=

# Facebook posting (node src/facebookCli.js) from an Android phone with ADB over Wi-Fi.
# If Facebook is signed out on the phone, the bot logs in with these.
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=
# Optional, such as 192.168.1.251:5555. Empty: scan the local network.
FACEBOOK_ADB_DEVICE=
