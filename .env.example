# Copy this file to .env and fill it in. Never commit or share .env.

# Your AniDay headhunter account
ANIDAY_EMAIL=
ANIDAY_PASSWORD=

# Your AreTalents account, used only by `npm run setup` to create the API key.
# With `npm run setup -- --register`, this is the account that gets created.
ARETALENTS_EMAIL=
ARETALENTS_PASSWORD=

# The www is required.
ARETALENTS_BASE_URL=https://www.aretalents.com

# Filled in by `npm run setup`.
ARETALENTS_API_KEY=
ARETALENTS_API_KEY_EXPIRES_AT=

# Threads posting (node src/threadsCli.js). The phone needs ADB over Wi-Fi and Threads signed in.
# Leave THREADS_ADB_DEVICE empty to scan the local network for it.
THREADS_ACCOUNT=
THREADS_ADB_DEVICE=
# Only needed if adb isn't on your PATH.
ADB_PATH=
